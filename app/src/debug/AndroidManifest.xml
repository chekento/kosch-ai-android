<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
             lintDebug evaluates the debug variant as its own manifest surface. Repeat the mediaProjection service
             declaration here so the foreground-service type remains explicit after source-set merging. This does
             not widen permissions or change the release manifest; the same service/type already exists in main.
        -->
        <service
            android:name=".assistant.AssistantScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
             Development-only N1 consent-boundary prototype. It is intentionally absent from release builds until
             a genuine eligible security/network capability exists and the Google Play VpnService declaration gate
             is satisfied. KoSchConsentVpnService itself remains inert and never establishes a tunnel.
        -->
        <activity
            android:name=".SecurityNetworkActivity"
            android:exported="false"
            android:screenOrientation="unspecified" />

        <service
            android:name=".security.KoSchConsentVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />
        </service>
    </application>
</manifest>
