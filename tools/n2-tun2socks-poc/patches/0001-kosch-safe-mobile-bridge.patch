diff --git a/engine/kosch_direct.go b/engine/kosch_direct.go
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/engine/kosch_direct.go
@@ -0,0 +1,157 @@
+package engine
+
+import (
+	"errors"
+	"fmt"
+	"sync"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+
+	"github.com/xjasonlyu/tun2socks/v2/dialer"
+)
+
+const maxAndroidFD = int64(1<<31 - 1)
+
+var (
+	koSchLifecycleMu sync.Mutex
+	koSchProtectorMu sync.RWMutex
+	koSchProtector   func(int64) bool
+)
+
+func setKoSchSocketProtector(protector func(int64) bool) {
+	koSchProtectorMu.Lock()
+	koSchProtector = protector
+	koSchProtectorMu.Unlock()
+}
+
+func clearKoSchSocketProtector() {
+	koSchProtectorMu.Lock()
+	koSchProtector = nil
+	koSchProtectorMu.Unlock()
+	dialer.ClearMandatorySockOpt()
+}
+
+func registerKoSchSocketProtector() error {
+	dialer.ClearMandatorySockOpt()
+
+	koSchProtectorMu.RLock()
+	protector := koSchProtector
+	koSchProtectorMu.RUnlock()
+	if protector == nil {
+		return errors.New("KoSch socket protector is required")
+	}
+
+	dialer.SetMandatorySockOpt(dialer.SocketOptionFunc(func(_, _ string, raw syscall.RawConn) error {
+		var protectErr error
+		controlErr := raw.Control(func(fd uintptr) {
+			if uint64(fd) > uint64(maxAndroidFD) {
+				protectErr = errors.New("socket fd exceeds Android int range")
+				return
+			}
+			if !protector(int64(fd)) {
+				protectErr = errors.New("VpnService.protect rejected upstream socket")
+			}
+		})
+		if controlErr != nil {
+			return controlErr
+		}
+		return protectErr
+	}))
+	return nil
+}
+
+func koSchDevicePresent() bool {
+	_engineMu.Lock()
+	defer _engineMu.Unlock()
+	return _defaultDevice != nil
+}
+
+func koSchEngineBusy() bool {
+	_engineMu.Lock()
+	defer _engineMu.Unlock()
+	return _defaultDevice != nil || _defaultStack != nil || _defaultKey != nil
+}
+
+func cleanupKoSchFailedStart(dupFD int) {
+	deviceOwnedFD := koSchDevicePresent()
+	_ = stop()
+	if !deviceOwnedFD {
+		_ = unix.Close(dupFD)
+	}
+	clearKoSchSocketProtector()
+}
+
+// StartKoSchDirect is the only engine start path used by the bound KoSch mobile
+// facade. It duplicates the Android-owned TUN descriptor before handing it to
+// the fdbased device because that device closes the descriptor it owns.
+//
+// The proxy is fixed to direct:// so N2 cannot acquire N4 proxy semantics.
+func StartKoSchDirect(originalFD int, mtu int, protector func(int64) bool) (err error) {
+	koSchLifecycleMu.Lock()
+	defer koSchLifecycleMu.Unlock()
+
+	if originalFD < 0 || int64(originalFD) > maxAndroidFD {
+		return errors.New("invalid Android TUN fd")
+	}
+	if mtu < 1280 || mtu > 9000 {
+		return errors.New("MTU must be between 1280 and 9000")
+	}
+	if protector == nil {
+		return errors.New("socket protector is required")
+	}
+	if koSchEngineBusy() {
+		return errors.New("forwarder engine is already active or dirty")
+	}
+
+	dupFD, dupErr := unix.Dup(originalFD)
+	if dupErr != nil {
+		return fmt.Errorf("duplicate TUN fd: %w", dupErr)
+	}
+
+	cleanupRequired := true
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			if cleanupRequired {
+				cleanupKoSchFailedStart(dupFD)
+			}
+			err = fmt.Errorf("forwarder start panic: %v", recovered)
+		}
+	}()
+
+	setKoSchSocketProtector(protector)
+	Insert(&Key{
+		MTU:                      mtu,
+		Mark:                     0,
+		Proxy:                    "direct://",
+		RestAPI:                  "",
+		Device:                   fmt.Sprintf("fd://%d", dupFD),
+		LogLevel:                 "warn",
+		Interface:                "",
+		TCPModerateReceiveBuffer: false,
+		TCPSendBufferSize:        "",
+		TCPReceiveBufferSize:     "",
+		MulticastGroups:          nil,
+		TUNPreUp:                 "",
+		TUNPostUp:                "",
+		UDPTimeout:               0,
+	})
+
+	if startErr := start(); startErr != nil {
+		cleanupKoSchFailedStart(dupFD)
+		cleanupRequired = false
+		return startErr
+	}
+
+	cleanupRequired = false
+	return nil
+}
+
+// StopKoSchDirect is idempotent and clears all Go references to the Android
+// socket-protector proxy after the engine has released its duplicated TUN fd.
+func StopKoSchDirect() (err error) {
+	koSchLifecycleMu.Lock()
+	defer koSchLifecycleMu.Unlock()
+	defer func() {
+		clearKoSchSocketProtector()
+		if recovered := recover(); recovered != nil {
+			err = fmt.Errorf("forwarder stop panic: %v", recovered)
+		}
+	}()
+
+	return stop()
+}
+
diff --git a/koschmobile/mobile.go b/koschmobile/mobile.go
new file mode 100644
index 0000000..4444444
--- /dev/null
+++ b/koschmobile/mobile.go
@@ -0,0 +1,93 @@
+// Package koschmobile is the only package exported through gomobile bind.
+// It deliberately hides engine.Key and the upstream Engine.Start/Stop wrappers.
+package koschmobile
+
+import (
+	"fmt"
+	"sync"
+
+	"github.com/xjasonlyu/tun2socks/v2/engine"
+)
+
+const maxAndroidFD = int64(1<<31 - 1)
+
+// SocketProtector is implemented by the future Android adapter. Protect must
+// delegate to VpnService.protect(fd); false means the socket must not proceed.
+type SocketProtector interface {
+	Protect(fd int64) bool
+}
+
+var (
+	mobileMu        sync.Mutex
+	running         bool
+	activeProtector SocketProtector
+)
+
+func safeProtect(protector SocketProtector, fd int64) (ok bool) {
+	defer func() {
+		if recover() != nil {
+			ok = false
+		}
+	}()
+	return protector.Protect(fd)
+}
+
+// Start starts only the fixed N2 direct forwarder. It returns an empty string
+// on success and a non-empty error string on failure so Go errors/panics never
+// need to cross the gomobile language boundary as exceptions.
+func Start(tunFD int64, mtu int64, protector SocketProtector) (result string) {
+	mobileMu.Lock()
+	defer mobileMu.Unlock()
+
+	defer func() {
+		if recovered := recover(); recovered != nil {
+			_ = engine.StopKoSchDirect()
+			running = false
+			activeProtector = nil
+			result = fmt.Sprintf("mobile start panic: %v", recovered)
+		}
+	}()
+
+	if running {
+		return "forwarder is already running"
+	}
+	if protector == nil {
+		return "socket protector is required"
+	}
+	if tunFD < 0 || tunFD > maxAndroidFD {
+		return "invalid Android TUN fd"
+	}
+	if mtu < 1280 || mtu > 9000 {
+		return "MTU must be between 1280 and 9000"
+	}
+
+	activeProtector = protector
+	err := engine.StartKoSchDirect(int(tunFD), int(mtu), func(fd int64) bool {
+		return safeProtect(protector, fd)
+	})
+	if err != nil {
+		activeProtector = nil
+		return err.Error()
+	}
+
+	running = true
+	return ""
+}
+
+// Stop is idempotent. It returns an empty string on success and always drops
+// the Java/Kotlin protector reference so proxy-reference cycles cannot survive
+// a stopped session.
+func Stop() (result string) {
+	mobileMu.Lock()
+	defer mobileMu.Unlock()
+
+	defer func() {
+		running = false
+		activeProtector = nil
+		if recovered := recover(); recovered != nil {
+			result = fmt.Sprintf("mobile stop panic: %v", recovered)
+		}
+	}()
+
+	if err := engine.StopKoSchDirect(); err != nil {
+		return err.Error()
+	}
+	return ""
+}
