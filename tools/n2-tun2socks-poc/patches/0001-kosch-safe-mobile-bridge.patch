diff --git a/engine/kosch_mobile.go b/engine/kosch_mobile.go
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/engine/kosch_mobile.go
@@ -0,0 +1,73 @@
+package engine
+
+import (
+	"errors"
+	"sync"
+	"syscall"
+
+	"github.com/xjasonlyu/tun2socks/v2/dialer"
+)
+
+// SocketProtector is intentionally gomobile-friendly. The Android adapter must
+// implement Protect by delegating to VpnService.protect(fd). Returning false
+// fails the socket creation path closed.
+type SocketProtector interface {
+	Protect(fd int64) bool
+}
+
+var (
+	koschProtectorMu sync.RWMutex
+	koschProtector   SocketProtector
+)
+
+// SetSocketProtector must be called before StartSafe. The protector is sampled
+// during start and installed as a mandatory dialer option before any direct
+// upstream socket is created.
+func SetSocketProtector(protector SocketProtector) {
+	koschProtectorMu.Lock()
+	koschProtector = protector
+	koschProtectorMu.Unlock()
+}
+
+func ClearSocketProtector() {
+	koschProtectorMu.Lock()
+	koschProtector = nil
+	koschProtectorMu.Unlock()
+}
+
+// StartSafe exposes the existing recoverable start() result instead of using
+// the upstream Start() wrapper, whose Fatalf path can terminate the process.
+func StartSafe() error { return start() }
+
+// StopSafe exposes recoverable shutdown and always removes the mandatory hook.
+func StopSafe() error {
+	err := stop()
+	dialer.ClearMandatorySockOpt()
+	return err
+}
+
+func registerKoSchSocketProtector() {
+	dialer.ClearMandatorySockOpt()
+
+	koschProtectorMu.RLock()
+	protector := koschProtector
+	koschProtectorMu.RUnlock()
+	if protector == nil {
+		return
+	}
+
+	dialer.SetMandatorySockOpt(dialer.SocketOptionFunc(func(_, _ string, raw syscall.RawConn) error {
+		var protectErr error
+		controlErr := raw.Control(func(fd uintptr) {
+			if fd > uintptr(2147483647) {
+				protectErr = errors.New("socket fd exceeds Android int range")
+				return
+			}
+			if !protector.Protect(int64(fd)) {
+				protectErr = errors.New("VpnService.protect rejected upstream socket")
+			}
+		})
+		if controlErr != nil {
+			return controlErr
+		}
+		return protectErr
+	}))
+}
